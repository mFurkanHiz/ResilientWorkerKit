# Example environment configuration for a ResilientWorkerKit host.
# Copy to .env (which is git-ignored) and fill in real values locally, or set these as
# environment variables / secret-manager entries in deployment.
#
# Never commit real credentials. Nothing in this file is a real value.

# --- Persistence -------------------------------------------------------------------
# SQLite (local development)
ConnectionStrings__WorkerKit=Data Source=worker-kit.db

# SQL Server (example shape — supply the password from a secret store, not from this file)
# ConnectionStrings__WorkerKit=Server=<host>;Database=<database>;User Id=<user>;Password=<from-secret-store>;Encrypt=True;TrustServerCertificate=False

# --- Outbound API integration ------------------------------------------------------
ReservationApi__BaseUrl=https://api.example.test/v1/
# ReservationApi__ApiKey=<from-secret-store>
# ReservationApi__ClientId=<from-secret-store>
# ReservationApi__ClientSecret=<from-secret-store>

# --- Logging -----------------------------------------------------------------------
Logging__LogLevel__Default=Information
Logging__LogLevel__ResilientWorkerKit=Information
