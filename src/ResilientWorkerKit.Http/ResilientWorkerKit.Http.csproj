<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ResilientWorkerKit.Http</PackageId>
    <Description>HTTP integration for ResilientWorkerKit jobs: typed HttpClient helpers with resilience (retry, circuit breaker, Retry-After, rate limiting), correlation and idempotency-key propagation, auth handlers, pagination helpers and secret-masking request logging.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResilientWorkerKit.Abstractions\ResilientWorkerKit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
